{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "hospitaldoctorstorageadf-dev"
		},
		"AzureDatabricksDeltaLake1_ls_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'AzureDatabricksDeltaLake1_ls'"
		},
		"AzureSqlDBhospitaldoctorhospital_s_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDBhospitaldoctorhospital_s'"
		},
		"hospitaldoctorstorage_ls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'hospitaldoctorstorage_ls'"
		},
		"AzureSqlDBhospitaldoctorhospital_s_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "appsqlserver00.database.windows.net"
		},
		"AzureSqlDBhospitaldoctorhospital_s_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "hospitaldoctor-hospital"
		},
		"AzureSqlDBhospitaldoctorhospital_s_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"hospitaldoctorstorage_ls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://hospitaldoctorstorage.dfs.core.windows.net/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/Generic_azure_db')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "AzureSqlDBhospitaldoctorhospital_s",
					"type": "LinkedServiceReference",
					"parameters": {
						"db_name": {
							"value": "@dataset().db_name",
							"type": "Expression"
						}
					}
				},
				"parameters": {
					"db_name": {
						"type": "string"
					},
					"schema_name": {
						"type": "string"
					},
					"table_name": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [],
				"typeProperties": {
					"schema": {
						"value": "@dataset().schema_name",
						"type": "Expression"
					},
					"table": {
						"value": "@dataset().table_name",
						"type": "Expression"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzureSqlDBhospitaldoctorhospital_s')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/AzureDatabricksDeltaLake1_ls')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureDatabricksDeltaLake",
				"typeProperties": {
					"domain": "https://adb-2480640637764719.19.azuredatabricks.net",
					"clusterId": "0305-091406-kfelio9a",
					"accessToken": {
						"type": "SecureString",
						"value": "[parameters('AzureDatabricksDeltaLake1_ls_accessToken')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/AzureSqlDBhospitaldoctorhospital_s')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"parameters": {
					"db_name": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('AzureSqlDBhospitaldoctorhospital_s_properties_typeProperties_server')]",
					"database": "[parameters('AzureSqlDBhospitaldoctorhospital_s_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('AzureSqlDBhospitaldoctorhospital_s_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('AzureSqlDBhospitaldoctorhospital_s_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/hospitaldoctorstorage_ls')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('hospitaldoctorstorage_ls_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('hospitaldoctorstorage_ls_accountKey')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}